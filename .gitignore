# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/Artifacts/Validation/

# Local workstation credentials and generated Blender backups/previews.
/.cursor/mcp.json
*.blend1
*.blend2
*.blend1.meta
*.blend2.meta
/ArtSource/**/Preview_*.png
/ArtSource/**/*montage*.png
/ArtSource/**/validation_report.json

# Unused generated asset export alternatives from the terrain lookdev sessions.
/GeneratedAssets/98cd99bdf02563e49abe14f750b25160/
/GeneratedAssets/daf4b634a8137da45af43c591d68dc7a/
/GeneratedAssets/db534c67502d44b479138a3d8fbe9e2f/

# Unreferenced terrain experiments retained locally.
/Assets/New Terrain 2.asset
/Assets/New Terrain 2.asset.meta
/Assets/TerrainData_5b64d327-83a7-46e2-9ccc-8a439851a681.asset
/Assets/TerrainData_5b64d327-83a7-46e2-9ccc-8a439851a681.asset.meta

# Local QA outputs; preserve inputs and generator source used by retained tools.
/Artifacts/*
!/Artifacts/TerrainRoadReliefV2/
!/Artifacts/PainterlyRoadLookdev/
/Artifacts/TerrainRoadReliefV2/*
!/Artifacts/TerrainRoadReliefV2/batch3b_baseline.bin
/Artifacts/PainterlyRoadLookdev/*
!/Artifacts/PainterlyRoadLookdev/process_texture.py

# MemoryCaptures can get excessive in size.
# They also could contain extremely sensitive data
/[Mm]emoryCaptures/

# Recordings can get excessive in size
/[Rr]ecordings/

# Uncomment this line if you wish to ignore the asset store tools plugin
# /[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio cache directory
.vs/

# Gradle cache directory
.gradle/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

