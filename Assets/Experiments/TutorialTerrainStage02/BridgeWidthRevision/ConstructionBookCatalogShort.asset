%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e20dbbfc419a44249814586c51beaf74, type: 3}
  m_Name: ConstructionBookCatalogShort
  m_EditorClassIdentifier: Assembly-CSharp::ConstructionBookCatalogSO
  entries:
  - component: {fileID: 11400000, guid: 44f08faeb2ef8124495422dfcefd6d62, type: 2}
    title: Wooden Foundation
    partSprite: {fileID: 21300000, guid: e66c85974a2948279eddae77baf0182b, type: 3}
    steps:
    - guidanceKey: foundation.clear
      instruction: Clear the marked foundation site
      detailedHelp: Use the Axe for wooden obstacles in the marked site. Work together
        to release any flexible sapling, then clear the area before digging.
      requirements:
      - displayName: Axe
        sprite: {fileID: 10905, guid: 0000000000000000f000000000000000, type: 0}
    - guidanceKey: foundation.soften.1
      instruction: Soften the next soil layer (cycle 1/3)
      detailedHelp: Use the Shovel on this foundation until the current layer is
        loosened, then remove its soil. Alternate softening and collection for all
        configured cycles.
      requirements:
      - displayName: Shovel
        sprite: {fileID: 10905, guid: 0000000000000000f000000000000000, type: 0}
    - guidanceKey: foundation.collect.1
      instruction: Collect the loosened soil (cycle 1/3)
      detailedHelp: Carry a bucket into the loosened soil; walking through it collects
        automatically. Hold the alternate action when using the bucket action. When
        full, leave the excavation and empty it outside, then return. Complete this
        collection cycle before softening again.
      requirements:
      - displayName: Bucket
        sprite: {fileID: 10905, guid: 0000000000000000f000000000000000, type: 0}
    - guidanceKey: foundation.soften.2
      instruction: Soften the next soil layer (cycle 2/3)
      detailedHelp: Use the Shovel on this foundation until the current layer is
        loosened, then remove its soil. Alternate softening and collection for all
        configured cycles.
      requirements:
      - displayName: Shovel
        sprite: {fileID: 10905, guid: 0000000000000000f000000000000000, type: 0}
    - guidanceKey: foundation.collect.2
      instruction: Collect the loosened soil (cycle 2/3)
      detailedHelp: Carry a bucket into the loosened soil; walking through it collects
        automatically. Hold the alternate action when using the bucket action. When
        full, leave the excavation and empty it outside, then return. Complete this
        collection cycle before softening again.
      requirements:
      - displayName: Bucket
        sprite: {fileID: 10905, guid: 0000000000000000f000000000000000, type: 0}
    - guidanceKey: foundation.soften.3
      instruction: Soften the next soil layer (cycle 3/3)
      detailedHelp: Use the Shovel on this foundation until the current layer is
        loosened, then remove its soil. Alternate softening and collection for all
        configured cycles.
      requirements:
      - displayName: Shovel
        sprite: {fileID: 10905, guid: 0000000000000000f000000000000000, type: 0}
    - guidanceKey: foundation.collect.3
      instruction: Collect the loosened soil (cycle 3/3)
      detailedHelp: Carry a bucket into the loosened soil; walking through it collects
        automatically. Hold the alternate action when using the bucket action. When
        full, leave the excavation and empty it outside, then return. Complete this
        collection cycle before softening again.
      requirements:
      - displayName: Bucket
        sprite: {fileID: 10905, guid: 0000000000000000f000000000000000, type: 0}
    - guidanceKey: foundation.concrete
      instruction: Bring ready concrete and pour together
      detailedHelp: Use the provided ready concrete batch. Dock an empty wheelbarrow
        at the mixer, load it, transport it to this foundation and dock it. Take
        the two pour slots, wait for a partner and coordinate the pouring controls.
        No material gathering or mixer recipe is needed. Use the Pickaxe on the hardened
        failed concrete. After it breaks, move the same trapped wheelbarrow out of
        the excavation, then reload and retry the pour.
      requirements:
      - displayName: Loaded Concrete Wheelbarrow
        sprite: {fileID: 10905, guid: 0000000000000000f000000000000000, type: 0}
      - displayName: Pickaxe
        sprite: {fileID: 6991357674887153452, guid: ebd4285913526c149b0f170953a45087, type: 3}
    - guidanceKey: foundation.dry
      instruction: Wait for the concrete to dry
      detailedHelp: You can help at another site while the concrete dries. Mount
        the foundation part after it becomes ready.
      requirements: []
    - guidanceKey: foundation.mount
      instruction: Carry the part into its ghost and hold steady
      detailedHelp: Carry the matching part together when needed. Move it into the
        ghost, match its position and rotation and keep it still until the socket
        mounts it.
      requirements:
      - displayName: Wooden Foundation
        sprite: {fileID: 10905, guid: 0000000000000000f000000000000000, type: 0}
    - guidanceKey: foundation.hammer
      instruction: Hammer the mounted foundation
      detailedHelp: Use the Industrial Hammer on the mounted foundation until its
        assembly is complete.
      requirements:
      - displayName: Industrial Hammer
        sprite: {fileID: 10905, guid: 0000000000000000f000000000000000, type: 0}
  - component: {fileID: 11400000, guid: 43e6a23a14d975d46927ef4c7c4a9df7, type: 2}
    title: Wooden Abutment
    partSprite: {fileID: 10905, guid: 0000000000000000f000000000000000, type: 0}
    steps:
    - guidanceKey: abutment.mount
      instruction: Carry the part into its ghost and hold steady
      detailedHelp: Carry the matching part together when needed. Move it into the
        ghost, match its position and rotation and keep it still until the socket
        mounts it.
      requirements:
      - displayName: Wooden Abutment
        sprite: {fileID: 10905, guid: 0000000000000000f000000000000000, type: 0}
    - guidanceKey: abutment.level
      instruction: Measure both axes, adjust, then confirm
      detailedHelp: Use the Spirit Level at the length and width measurement points.
        Read its visible result, adjust the appropriate points with the Industrial
        Hammer and measure again. Confirm leveling with interact when both axes are
        correct.
      requirements:
      - displayName: Spirit Level
        sprite: {fileID: 10905, guid: 0000000000000000f000000000000000, type: 0}
      - displayName: Industrial Hammer
        sprite: {fileID: 10905, guid: 0000000000000000f000000000000000, type: 0}
    - guidanceKey: abutment.anchor
      instruction: Hammer all four anchors
      detailedHelp: Work around the abutment and hammer each of its four anchors
        until every anchor is secure.
      requirements:
      - displayName: Industrial Hammer
        sprite: {fileID: 10905, guid: 0000000000000000f000000000000000, type: 0}
    - guidanceKey: abutment.backfill
      instruction: Backfill the abutment
      detailedHelp: Use the Shovel at the abutment's backfill points until backfilling
        is complete.
      requirements:
      - displayName: Shovel
        sprite: {fileID: 10905, guid: 0000000000000000f000000000000000, type: 0}
  - component: {fileID: 11400000, guid: b6305c7c75a843545bfccf4469169d66, type: 2}
    title: Wooden Main Girder
    partSprite: {fileID: 10905, guid: 0000000000000000f000000000000000, type: 0}
    steps:
    - guidanceKey: girder.mount
      instruction: Carry the part into its ghost and hold steady
      detailedHelp: Carry the matching part together when needed. Move it into the
        ghost, match its position and rotation and keep it still until the socket
        mounts it.
      requirements:
      - displayName: Wooden Main Girder
        sprite: {fileID: 10905, guid: 0000000000000000f000000000000000, type: 0}
    - guidanceKey: girder.level
      instruction: Measure both axes, adjust, then confirm
      detailedHelp: Use the Spirit Level at the length and width measurement points.
        Read its visible result, adjust the appropriate points with the Industrial
        Hammer and measure again. Confirm leveling with interact when both axes are
        correct.
      requirements:
      - displayName: Spirit Level
        sprite: {fileID: 10905, guid: 0000000000000000f000000000000000, type: 0}
      - displayName: Industrial Hammer
        sprite: {fileID: 10905, guid: 0000000000000000f000000000000000, type: 0}
    - guidanceKey: girder.fasten
      instruction: Strike the diagonal fastener pairs
      detailedHelp: Use the Industrial Hammer. After starting a fastener, strike
        its diagonally opposite partner before the pair timer expires. Coordinate
        both pairs with your partner.
      requirements:
      - displayName: Industrial Hammer
        sprite: {fileID: 10905, guid: 0000000000000000f000000000000000, type: 0}
  - component: {fileID: 11400000, guid: 12d9e4ecb93ef464eb2cbcbbcf3b917b, type: 2}
    title: Wooden Cross Beam
    partSprite: {fileID: 10905, guid: 0000000000000000f000000000000000, type: 0}
    steps:
    - guidanceKey: crossbeam.mount
      instruction: Carry the part into its ghost and hold steady
      detailedHelp: Carry the matching part together when needed. Move it into the
        ghost, match its position and rotation and keep it still until the socket
        mounts it.
      requirements:
      - displayName: Wooden Cross Beam
        sprite: {fileID: 10905, guid: 0000000000000000f000000000000000, type: 0}
    - guidanceKey: crossbeam.align
      instruction: Hammer the cross beam into alignment
      detailedHelp: Strike the indicated alignment points from opposed directions
        to correct the cross beam's offset. Continue until alignment is accepted.
      requirements:
      - displayName: Industrial Hammer
        sprite: {fileID: 10905, guid: 0000000000000000f000000000000000, type: 0}
    - guidanceKey: crossbeam.clamp
      instruction: Alternate between the two clamps
      detailedHelp: Use the Wrench on the left and right clamps alternately. Keep
        their progress close; a clamp cannot advance too far ahead of the other.
      requirements:
      - displayName: Wrench
        sprite: {fileID: 10905, guid: 0000000000000000f000000000000000, type: 0}
    - guidanceKey: crossbeam.fasten
      instruction: Tighten the cross beam fasteners
      detailedHelp: Use the Wrench on every indicated fastener until the cross beam
        is complete.
      requirements:
      - displayName: Wrench
        sprite: {fileID: 10905, guid: 0000000000000000f000000000000000, type: 0}
  - component: {fileID: 11400000, guid: 761835b646cc7f54583dafcefd23cd49, type: 2}
    title: Wooden Diagonal Bracing
    partSprite: {fileID: 10905, guid: 0000000000000000f000000000000000, type: 0}
    steps:
    - guidanceKey: brace.mount
      instruction: Carry the part into its ghost and hold steady
      detailedHelp: Carry the matching part together when needed. Move it into the
        ghost, match its position and rotation and keep it still until the socket
        mounts it.
      requirements:
      - displayName: Wooden Diagonal Bracing
        sprite: {fileID: 10905, guid: 0000000000000000f000000000000000, type: 0}
    - guidanceKey: brace.align
      instruction: Hammer the brace to the right angle
      detailedHelp: Strike the brace's angle adjustment points with the Industrial
        Hammer until alignment is accepted.
      requirements:
      - displayName: Industrial Hammer
        sprite: {fileID: 10905, guid: 0000000000000000f000000000000000, type: 0}
    - guidanceKey: brace.fix
      instruction: Temporarily fix both brace ends
      detailedHelp: Use the Industrial Hammer at the start and end fixing points.
        Secure both ends before tightening the fasteners.
      requirements:
      - displayName: Industrial Hammer
        sprite: {fileID: 10905, guid: 0000000000000000f000000000000000, type: 0}
    - guidanceKey: brace.fasten
      instruction: Tighten the brace in the indicated order
      detailedHelp: 'Use the Wrench and follow the highlighted fastener order: start
        top, end bottom, start bottom, end top.'
      requirements:
      - displayName: Wrench
        sprite: {fileID: 10905, guid: 0000000000000000f000000000000000, type: 0}
  - component: {fileID: 11400000, guid: ccf15358972f0704385ec5d608ff91f4, type: 2}
    title: Wooden Deck Panel
    partSprite: {fileID: 10905, guid: 0000000000000000f000000000000000, type: 0}
    steps:
    - guidanceKey: panel.place
      instruction: Place the panel by hand and assess its pose
      detailedHelp: Pick up the physical panel, use hand placement over its marked
        slot and release it to assess the pose. Correct its position, height and
        orientation. For a bad nailed pose, use the Crowbar to remove the nails and
        reset the panel before trying again.
      requirements:
      - displayName: Wooden Deck Panel
        sprite: {fileID: 10905, guid: 0000000000000000f000000000000000, type: 0}
      - displayName: Crowbar
        sprite: {fileID: 21300000, guid: 78099bae4e543ab4d85aa61eebc7cef5, type: 3}
    - guidanceKey: panel.nail
      instruction: Secure all four panel quarters
      detailedHelp: Place a separate Mounting Nail through the panel into a main
        girder in each quarter. Each nail must connect both objects and receive its
        configured number of Industrial Hammer strikes. Nails on the quarter boundaries
        or into the wrong object do not count. Remove incorrect nails with the Crowbar.
      requirements:
      - displayName: Industrial Hammer
        sprite: {fileID: 10905, guid: 0000000000000000f000000000000000, type: 0}
      - displayName: Crowbar
        sprite: {fileID: 21300000, guid: 78099bae4e543ab4d85aa61eebc7cef5, type: 3}
